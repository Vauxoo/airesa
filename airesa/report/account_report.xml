<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_invoice" model="ir.actions.report">
        <field name="name">Airesa Customer Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">airesa.report_invoice</field>
        <field name="report_file">airesa.report_invoice</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt'))]</field>
        <field name="is_invoice_report">True</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('account.group_account_invoice')), Command.link(ref('account.group_account_readonly'))]"
        />
    </record>
</odoo>
